# Node
node_modules/

# Build output
dist/
build/

# TypeScript
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
coverage-final.json
.nyc_output/

# OS files
.DS_Store
Thumbs.db

# Editor directories and files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Environment variables
.env
.env.*
!.env.example

# Prisma
.prisma/
# Do NOT ignore prisma/migrations (keep migrations under version control)
# If you have a local sqlite db for dev, ignore it
dev.db
*.sqlite
*.db
*.db-shm
*.db-wal

# Generated Prisma client inside node_modules is covered by node_modules/

# Temporary / cache
tmp/
temp/
.cache/
*.tmp

# Misc
*.tgz
*.zip
*.gz

# Containers / docker
docker-compose.override.yml

# Test outputs
jest-test-results.json

# IDE / Tools
.vscode-test/

# Avoid committing agent/tool artifacts that may have been created in this workspace
.agents/
.claude/
.windsurf/

# Keep lockfiles and package manifests
!package.json
!package-lock.json

# Keep prisma schema and migrations (already tracked by default)
!prisma/schema.prisma
!prisma/migrations/
