generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Movie {
  id                            String   @id
  title                         String
  description                   String
  originalNumIdFromOriginalSource Int
  originalAlphIdFromOriginalSource String
  urlMedia                      String?
  urlHorizontalPoster           String?
  urlVerticalPoster             String?
  subtitles                     String?
  categories                    Category[]
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
  movies Movie[]
}